% =========================================================================
% pareto_front_analysis.m
%
% PARETO FRONT ANALYSIS — LQR Optimal Control Tradeoff
%
% Reveals the complete tradeoff between:
%   Objective 1: Settling time       
%   Objective 2: RMS control effort   
%
% Method: Weighted Q/R scaling sweep
%   Q(alpha) = alpha * Q0_bryson
%   R(alpha) = (1/alpha) * R0_bryson
%
% Alpha range: 0.001 to 10 (logspace)
%
% Pole placement Sets 1 and 2 are SIMULATED (not approximated) so their
% RMS control effort is on the same basis as LQR points.
%
% Part of: CR3BP Spacecraft Control at Earth-Moon L2 Point
% =========================================================================

clear; clc; close all;
addpath(fullfile(fileparts(mfilename('fullpath')), 'utils'));

%% =========================================================================
%  SYSTEM SETUP
%% =========================================================================
[A, B, C, D, E]      = get_system_matrices();
w1                    = 1;
[G1, G2, Aa, Ba, Ea] = get_servo_matrices(A, B, C, E, w1);

% Observer gain — fixed throughout
p_obs = [-20+2j, -20-2j, -25+2j, -25-2j];
L     = place(A', C', p_obs)';

% Simulation parameters
T      = 30;
w0     = [1; 1; 0; 0];
w_hat0 = [0; 0; 0; 0];

% Settling threshold — 5% allows meaningful variation across alpha range.
% Tighter thresholds (e.g. 1%) are floored by steady-state disturbance
% oscillation and produce artificially flat settling time curves.
settle_thresh = 0.05;

%% =========================================================================
%  STEP 1: SIMULATE POLE PLACEMENT CONTROLLERS
%  Simulated first so PP points use identical RMS metric as LQR points
%% =========================================================================
poles_1 = [-2.1587, -0.1, -0.5+1.8626j, -0.5-1.8626j, ...
            -2+2j,   -2-2j, -3+1j, -3-1j, -4, -5];
poles_2 = [-3+3j, -3-3j, -4+4j, -4-4j, ...
            -3+1j, -3-1j, -4+2j, -4-2j, -5, -6];

fprintf('=== Simulating Pole Placement Controllers ===\n');
pp_results = struct();

for m = 1:2
    if m == 1
        poles_m = poles_1;  label_m = 'Set 1 (Conservative)';
    else
        poles_m = poles_2;  label_m = 'Set 2 (Aggressive)';
    end

    Ka_m     = place(Aa, Ba, poles_m);
    Kx_m     = Ka_m(:, 1:4);
    Ki_m     = Ka_m(:, 5:10);

    cl_eigs_m  = eig(Aa - Ba*Ka_m);
    max_eig_m  = max(abs(real(cl_eigs_m)));
    dt_m       = min(0.005, 0.5 / max_eig_m);
    dt_m       = max(dt_m, 1e-5);

    [w_m, ~, ~, u_m, t_m] = run_simulation(A, B, C, E, G1, G2, ...
                                             Kx_m, Ki_m, L, ...
                                             w0, w_hat0, dt_m, T, w1);

    pp_results(m).settle = compute_settling_time(t_m, w_m, settle_thresh);
    pp_results(m).rms_u  = sqrt(mean(u_m(1,:).^2 + u_m(2,:).^2));
    pp_results(m).max_u1 = max(abs(u_m(1,:)));
    pp_results(m).max_u2 = max(abs(u_m(2,:)));
    pp_results(m).label  = label_m;

    fprintf('  PP %s:\n', label_m);
    fprintf('    Settling time      = %.3f s\n', pp_results(m).settle);
    fprintf('    RMS control effort = %.3f\n',   pp_results(m).rms_u);
    fprintf('    Max |u1|           = %.3f\n',   pp_results(m).max_u1);
    fprintf('    Max |u2|           = %.3f\n\n', pp_results(m).max_u2);
end

%% =========================================================================
%  STEP 2: BRYSON'S BASELINE Q0, R0
%% =========================================================================
x_max    = 0.5;  y_max    = 0.5;
xdot_max = 0.5;  ydot_max = 0.5;
u1_max   = 200;  u2_max   = 200;

Q_plant = diag([1/x_max^2, 1/y_max^2, 1/xdot_max^2, 1/ydot_max^2]);
Q_servo = 1.0 * eye(6);
Q0      = blkdiag(Q_plant, Q_servo);
R0      = diag([1/u1_max^2, 1/u2_max^2]);

%% =========================================================================
%  STEP 3: ALPHA SWEEP
%  Range: 0.001 to 10 — covers full useful range without redundant plateau
%% =========================================================================
n_alpha   = 100;
alpha_vec = logspace(-3, 1, n_alpha);   % 0.001 to 10

settle_vec  = nan(1, n_alpha);
rms_u_vec   = nan(1, n_alpha);
max_u1_vec  = nan(1, n_alpha);
max_u2_vec  = nan(1, n_alpha);
alpha_valid = true(1, n_alpha);

fprintf('=== Pareto Front Sweep ===\n');
fprintf('Alpha range: %.4f to %.1f  (%d points)\n', ...
        alpha_vec(1), alpha_vec(end), n_alpha);
fprintf('Settling threshold: %.2f\n\n', settle_thresh);

for i = 1:n_alpha
    alpha = alpha_vec(i);
    Q_i   = alpha * Q0;
    R_i   = (1/alpha) * R0;

    % Solve LQR
    try
        Ka_i = lqr(Aa, Ba, Q_i, R_i);
    catch ME
        fprintf('  [SKIP] alpha=%.5f : LQR failed — %s\n', alpha, ME.message);
        alpha_valid(i) = false;
        continue;
    end

    % Check stability
    cl_eigs = eig(Aa - Ba * Ka_i);
    if any(real(cl_eigs) >= 0)
        fprintf('  [SKIP] alpha=%.5f : Unstable\n', alpha);
        alpha_valid(i) = false;
        continue;
    end

    % Adaptive dt — prevents Euler blowup for large gains
    max_eig_real = max(abs(real(cl_eigs)));
    dt_i         = min(0.005, 0.5 / max_eig_real);
    dt_i         = max(dt_i, 1e-5);

    Kx_i = Ka_i(:, 1:4);
    Ki_i = Ka_i(:, 5:10);

    % Simulate
    [w_i, ~, ~, u_i, t_i] = run_simulation(A, B, C, E, G1, G2, ...
                                             Kx_i, Ki_i, L, ...
                                             w0, w_hat0, dt_i, T, w1);

    % Check for blowup
    if any(~isfinite(w_i(:))) || any(~isfinite(u_i(:)))
        fprintf('  [SKIP] alpha=%.5f : Blowup detected\n', alpha);
        alpha_valid(i) = false;
        continue;
    end

    % Metrics
    settle_vec(i) = compute_settling_time(t_i, w_i, settle_thresh);
    rms_u_vec(i)  = sqrt(mean(u_i(1,:).^2 + u_i(2,:).^2));
    max_u1_vec(i) = max(abs(u_i(1,:)));
    max_u2_vec(i) = max(abs(u_i(2,:)));

    if mod(i,5) == 0 || i == 1
        fprintf('  [%2d/%2d] alpha=%7.4f  dt=%.2e  settle=%6.2fs  RMS|u|=%6.2f\n', ...
                i, n_alpha, alpha, dt_i, settle_vec(i), rms_u_vec(i));
    end
end

% Filter 1 — remove numerically invalid points
valid = alpha_valid          & ...
        isfinite(settle_vec) & ...
        isfinite(rms_u_vec)  & ...
        settle_vec > 0       & ...
        rms_u_vec  > 0;

alpha_valid_vals = alpha_vec(valid);
settle_valid     = settle_vec(valid);
rms_u_valid      = rms_u_vec(valid);

fprintf('\nValid points (finite): %d / %d\n', sum(valid), n_alpha);

% Filter 2 — remove points that never actually settled within simulation
settled_mask     = settle_valid < (T * 0.95);
n_before         = length(alpha_valid_vals);
alpha_valid_vals = alpha_valid_vals(settled_mask);
settle_valid     = settle_valid(settled_mask);
rms_u_valid      = rms_u_valid(settled_mask);

fprintf('Points that actually settle: %d / %d\n', ...
        length(alpha_valid_vals), n_before);
fprintf('Settling time range : %.3f  to  %.3f s\n', min(settle_valid), max(settle_valid));
fprintf('RMS effort range    : %.3f  to  %.3f\n',   min(rms_u_valid),  max(rms_u_valid));

if length(alpha_valid_vals) < 3
    error(['Too few settled points (%d). ' ...
           'Try increasing T or loosening settle_thresh.'], ...
           length(alpha_valid_vals));
end

%% =========================================================================
%  STEP 4: KEY POINTS
%% =========================================================================

% Bryson's point (alpha = 1)
[~, bryson_idx] = min(abs(alpha_valid_vals - 1.0));
bryson_settle   = settle_valid(bryson_idx);
bryson_u        = rms_u_valid(bryson_idx);

fprintf('\nBryson''s point (alpha=1.0):\n');
fprintf('  Settling time      = %.4f s\n', bryson_settle);
fprintf('  RMS control effort = %.4f\n',   bryson_u);

% Normalise both objectives to [0,1]
u_norm  = (rms_u_valid  - min(rms_u_valid))  / (max(rms_u_valid)  - min(rms_u_valid));
st_norm = (settle_valid - min(settle_valid))  / (max(settle_valid) - min(settle_valid));

% Knee point — slope threshold method
n_pts       = length(settle_valid);
local_slope = zeros(1, n_pts-1);
for ii = 1:n_pts-1
    d_settle = settle_valid(ii) - settle_valid(ii+1);
    d_rms    = rms_u_valid(ii+1) - rms_u_valid(ii);
    if d_rms > 1e-6
        local_slope(ii) = d_settle / d_rms;
    end
end

max_slope  = max(local_slope);
threshold  = 0.02 * max_slope;
knee_trans = find(local_slope < threshold, 1, 'first');

if isempty(knee_trans)
    knee_idx = round(n_pts * 0.25);
else
    knee_idx = knee_trans;
end
knee_idx = min(knee_idx, n_pts);

knee_settle = settle_valid(knee_idx);
knee_u      = rms_u_valid(knee_idx);
knee_alpha  = alpha_valid_vals(knee_idx);

fprintf('\nKnee point:\n');
fprintf('  alpha              = %.6f\n',   knee_alpha);
fprintf('  Settling time      = %.4f s\n', knee_settle);
fprintf('  RMS control effort = %.4f\n',   knee_u);

%% =========================================================================
%  STEP 5: SAVE
%% =========================================================================
if ~exist('../results','dir'); mkdir('../results'); end

Ka_knee_saved   = lqr(Aa, Ba, knee_alpha*Q0, (1/knee_alpha)*R0);
Ka_bryson_saved = lqr(Aa, Ba, Q0, R0);

cl_knee   = eig(Aa - Ba*Ka_knee_saved);
dt_knee   = min(0.005, 0.5 / max(abs(real(cl_knee))));
dt_knee   = max(dt_knee, 1e-5);

cl_bryson = eig(Aa - Ba*Ka_bryson_saved);
dt_bryson = min(0.005, 0.5 / max(abs(real(cl_bryson))));
dt_bryson = max(dt_bryson, 1e-5);

fprintf('\ndt_knee   = %.2e\n', dt_knee);
fprintf('dt_bryson = %.2e\n', dt_bryson);

save('../results/pareto_data.mat', ...
     'alpha_valid_vals', 'settle_valid', 'rms_u_valid', ...
     'max_u1_vec', 'max_u2_vec', 'pp_results', ...
     'knee_alpha', 'knee_settle', 'knee_u', ...
     'bryson_settle', 'bryson_u', 'bryson_idx', 'knee_idx', ...
     'u_norm', 'st_norm', 'settle_thresh', ...
     'Ka_knee_saved', 'Ka_bryson_saved', 'Q0', 'R0', ...
     'dt_knee', 'dt_bryson');
fprintf('\nPareto data saved to results/pareto_data.mat\n');

%% =========================================================================
%  FIGURES
%% =========================================================================
if ~exist('../docs/figures','dir'); mkdir('../docs/figures'); end

all_u      = [rms_u_valid,  pp_results(1).rms_u,  pp_results(2).rms_u];
all_settle = [settle_valid, pp_results(1).settle,  pp_results(2).settle];
x_pad = (max(all_u)      - min(all_u))     * 0.13;
y_pad = (max(all_settle) - min(all_settle)) * 0.13;
x_lim = [max(0, min(all_u)      - x_pad), max(all_u)      + x_pad];
y_lim = [max(0, min(all_settle) - y_pad), max(all_settle) + y_pad];

%% ---- Figure 1: Main Pareto Front ---------------------------------------
figure('Name','Pareto Front','NumberTitle','off','Position',[50 50 950 680]);

plot(rms_u_valid, settle_valid, 'b-o', ...
     'LineWidth', 2, 'MarkerSize', 5, ...
     'MarkerFaceColor', 'b', 'DisplayName', 'Pareto Front (LQR)');
hold on;

scatter(pp_results(1).rms_u, pp_results(1).settle, 200, 'r', 's', ...
        'LineWidth', 2.5, 'DisplayName', 'Pole Placement Set 1');
scatter(pp_results(2).rms_u, pp_results(2).settle, 200, 'm', 's', ...
        'LineWidth', 2.5, 'DisplayName', 'Pole Placement Set 2');
scatter(bryson_u, bryson_settle, 240, [0 0.6 0], '^', ...
        'LineWidth', 2.5, 'MarkerFaceColor', [0 0.6 0], ...
        'DisplayName', 'Bryson''s Method (\alpha=1)');
scatter(knee_u, knee_settle, 240, [1 0.5 0], 'p', ...
        'LineWidth', 2.5, 'MarkerFaceColor', [1 0.5 0], ...
        'DisplayName', sprintf('Knee Point (\\alpha=%.3f)', knee_alpha));

ox = (x_lim(2)-x_lim(1)) * 0.02;
oy = (y_lim(2)-y_lim(1)) * 0.015;
text(pp_results(1).rms_u+ox, pp_results(1).settle+oy, ...
     sprintf('PP Set 1\n(%.1fs, %.1f)', pp_results(1).settle, pp_results(1).rms_u), ...
     'Color','r','FontSize',8);
text(pp_results(2).rms_u+ox, pp_results(2).settle+oy, ...
     sprintf('PP Set 2\n(%.1fs, %.1f)', pp_results(2).settle, pp_results(2).rms_u), ...
     'Color','m','FontSize',8);
text(bryson_u+ox, bryson_settle+oy, ...
     sprintf('Bryson\n(%.1fs, %.1f)', bryson_settle, bryson_u), ...
     'Color',[0 0.6 0],'FontSize',8);
text(knee_u+ox, knee_settle+oy, ...
     sprintf('Knee\n(%.1fs, %.1f)', knee_settle, knee_u), ...
     'Color',[1 0.5 0],'FontSize',8);

xlabel('RMS Control Effort  \surd(mean(u_1^2 + u_2^2))', 'FontSize', 12);
ylabel('Settling Time (s)', 'FontSize', 12);
title({'Pareto Front: Settling Time vs. RMS Control Effort', ...
       'LQR with Bryson''s Method Baseline  (Q = \alpha Q_0,  R = R_0/\alpha)'}, ...
      'FontSize', 12);
legend('Location','best','FontSize',10);
grid on;
xlim(x_lim);  ylim(y_lim);

saveas(gcf,'../docs/figures/06a_pareto_front.png');
fprintf('Saved: 06a_pareto_front.png\n');

%% ---- Figure 2: Alpha vs Both Objectives --------------------------------
figure('Name','Alpha Sweep','NumberTitle','off','Position',[50 50 950 520]);

yyaxis left
semilogx(alpha_valid_vals, settle_valid, 'b-o', 'LineWidth', 2, 'MarkerSize', 5);
ylabel('Settling Time (s)', 'Color','b', 'FontSize',11);
ylim([0, max(settle_valid)*1.15]);

yyaxis right
semilogx(alpha_valid_vals, rms_u_valid, 'r-s', 'LineWidth', 2, 'MarkerSize', 5);
ylabel('RMS Control Effort', 'Color','r', 'FontSize',11);
ylim([0, max(rms_u_valid)*1.15]);

yyaxis left
xline(1.0,        'g--', '\alpha=1 (Bryson)', 'LineWidth', 1.8, ...
      'LabelVerticalAlignment','bottom','FontSize',9);
xline(knee_alpha, 'k--', sprintf('\\alpha=%.3f (Knee)', knee_alpha), ...
      'LineWidth', 1.8, 'LabelVerticalAlignment','bottom','FontSize',9);

xlabel('\alpha  (Q/R scaling factor — log scale)', 'FontSize',11);
title('Effect of \alpha on Settling Time and RMS Control Effort','FontSize',12);
grid on;

saveas(gcf,'../docs/figures/06b_alpha_sweep.png');
fprintf('Saved: 06b_alpha_sweep.png\n');

%% ---- Figure 3: Normalised Pareto tradeoff space ------------------------
figure('Name','Normalised Pareto','NumberTitle','off','Position',[50 50 720 620]);

plot(u_norm, st_norm, 'b-o', 'LineWidth', 2, 'MarkerSize', 5, ...
     'MarkerFaceColor','b', 'DisplayName','Pareto Front (LQR)');
hold on;

pp1_un = (pp_results(1).rms_u  - min(rms_u_valid))  / (max(rms_u_valid)  - min(rms_u_valid));
pp1_sn = (pp_results(1).settle - min(settle_valid))  / (max(settle_valid) - min(settle_valid));
pp2_un = (pp_results(2).rms_u  - min(rms_u_valid))  / (max(rms_u_valid)  - min(rms_u_valid));
pp2_sn = (pp_results(2).settle - min(settle_valid))  / (max(settle_valid) - min(settle_valid));

scatter(min(pp1_un,1.15), min(pp1_sn,1.15), 200, 'r', 's', ...
        'LineWidth',2.5, 'DisplayName','Pole Placement Set 1');
scatter(min(pp2_un,1.15), min(pp2_sn,1.15), 200, 'm', 's', ...
        'LineWidth',2.5, 'DisplayName','Pole Placement Set 2');
scatter(u_norm(bryson_idx), st_norm(bryson_idx), 220, [0 0.6 0], '^', ...
        'LineWidth',2.5, 'MarkerFaceColor',[0 0.6 0], ...
        'DisplayName','Bryson''s Method');
scatter(u_norm(knee_idx), st_norm(knee_idx), 220, [1 0.5 0], 'p', ...
        'LineWidth',2.5, 'MarkerFaceColor',[1 0.5 0], ...
        'DisplayName','Knee Point');

plot([0 1],[1 0],'k--','LineWidth',1,'HandleVisibility','off');
text(0.72, 0.88, 'High effort,  Fast','FontSize',8,'Color',[0.5 0.5 0.5]);
text(0.03, 0.12, 'Low effort,  Slow', 'FontSize',8,'Color',[0.5 0.5 0.5]);

xlabel('Normalised RMS Control Effort  (0=min, 1=max)','FontSize',11);
ylabel('Normalised Settling Time  (0=min, 1=max)',      'FontSize',11);
title('Normalised Pareto Front — Tradeoff Space','FontSize',12);
legend('Location','northeast','FontSize',10);
grid on;
axis([0 1.1 0 1.1]);

saveas(gcf,'../docs/figures/06c_pareto_normalised.png');
fprintf('Saved: 06c_pareto_normalised.png\n');

%% =========================================================================
%  SUMMARY TABLE
%% =========================================================================
fprintf('\n=== Pareto Front Summary ===\n');
fprintf('%-30s %-15s %-20s %-12s\n','Controller','Settling (s)','RMS Effort','Alpha');
fprintf('%s\n', repmat('-',1,80));
fprintf('%-30s %-15.3f %-20.3f %-12s\n',  'PP Set 1 (Conservative)', ...
        pp_results(1).settle, pp_results(1).rms_u, 'N/A');
fprintf('%-30s %-15.3f %-20.3f %-12s\n',  'PP Set 2 (Aggressive)', ...
        pp_results(2).settle, pp_results(2).rms_u, 'N/A');
fprintf('%-30s %-15.3f %-20.3f %-12.4f\n','LQR Bryson (alpha=1)', ...
        bryson_settle, bryson_u, 1.0);
fprintf('%-30s %-15.3f %-20.3f %-12.4f\n','LQR Knee Point', ...
        knee_settle, knee_u, knee_alpha);
fprintf('\nAll figures saved to docs/figures/\n');